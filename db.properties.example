# OPTIONAL. Isla saves to a built-in database (the isla-data folder) with no setup.
# Only create "db.properties" if you want to use your own MySQL server instead.
# Copy this file to "db.properties" (next to pom.xml) and fill in your MySQL details.
# Create the database first:  CREATE DATABASE isla CHARACTER SET utf8mb4;
url=jdbc:mysql://localhost:3306/isla
user=root
password=
